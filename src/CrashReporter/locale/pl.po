msgid "Close the screen and exit all menus"
msgstr "Zamknij ekran i wyjdź ze wszystkich menu"

#: ../plugin.py:118
msgid "Close ticket"
msgstr "Zamknij zgłoszenie"

#: ../plugin.py:90
msgid "Closed"
msgstr "Zamknięte"

#: ../plugin.py:340
msgid "Complete Your Crash Report"
msgstr "Dokończ zgłoszenie awarii"

#: ../plugin.py:501
#, python-format
msgid "Crash Report %s"
msgstr "Zgłoszenie awarii %s"

