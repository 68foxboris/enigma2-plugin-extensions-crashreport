#: ../plugin.py:344
#, python-format
msgid ""
"%s\n"
"\n"
"Sign in or register and confirm your email. Then describe the problem and submit the report within 48 hours. The box model is supplied automatically."
msgstr ""
"%s\n"
"\n"
"Zaloguj się lub zarejestruj i potwierdź swój adres e-mail. Następnie opisz problem i wyślij zgłoszenie w ciągu 48 godzin. Model odbiornika zostanie podany automatycznie."

#: ../plugin.py:765
msgid "A developer has answered your crash report. Would you like to read the answer now?"
msgstr "Programista odpowiedział na Twoje zgłoszenie awarii. Czy chcesz teraz przeczytać odpowiedź?"

#: ../plugin.py:528
msgid "Answer"
msgstr "Odpowiedz"

#: ../plugin.py:576
#, python-format
msgid "Answer for ticket #%s (at most %d characters)"
msgstr "Odpowiedź do zgłoszenia #%s (maksymalnie %d znaków)"

#: ../plugin.py:388
msgid "Ask the report server again"
msgstr "Ponownie sprawdź na serwerze zgłoszeń"

#: ../plugin.py:380
msgid "Asking the report server for the state of your reports..."
msgstr "Sprawdzanie stanu Twoich zgłoszeń na serwerze zgłoszeń..."

#: ../plugin.py:530
msgid "Attach"
msgstr "Dołącz"

#: ../plugin.py:192 ../plugin.py:345 ../plugin.py:381 ../plugin.py:504
msgid "Close"
msgstr "Zamknij"

